# ==== Skopiuj do .env i uzupełnij. Linie z # to komentarze. ====

# Publiczny adres sklepu (bez ukośnika na końcu). Używany w linkach dostępu, e-mailach i Stripe.
BASE_URL=https://twojadomena.pl
# Domena dla Caddy (automatyczne HTTPS) – ta sama co w BASE_URL, bez https://
DOMAIN=twojadomena.pl
# Nazwa marki widoczna w e-mailach i panelu
SITE_NAME=Odhacz

# Port aplikacji w kontenerze (zostaw 3000)
PORT=3000
NODE_ENV=production

# ---- Stripe (Dashboard -> Developers -> API keys) ----
# Brak klucza = TRYB TESTOWY (fałszywy checkout, bez prawdziwych płatności). W produkcji wymagany.
STRIPE_SECRET_KEY=sk_live_...
# Dashboard -> Developers -> Webhooks -> endpoint https://twojadomena.pl/webhook/stripe -> "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_...
# Tekst zgody w Stripe Checkout (checkbox wymagany, domyślnie odznaczony). Zawiera żądanie natychmiastowej dostawy,
# informację o utracie prawa odstąpienia (art. 38 ust. 1 pkt 13 UPK) i akceptację regulaminu/polityki. Domyślna treść
# (src/config.js, DEFAULT_TERMS_TEXT; finalne brzmienie i uzasadnienie: legal/01-teksty.md):
#   Akceptuję [Regulamin]({BASE_URL}/legal/regulamin.html) i [Politykę prywatności]({BASE_URL}/legal/polityka-prywatnosci.html). Żądam dostarczenia treści cyfrowej od razu po zapłacie, wyrażam na to wyraźną zgodę i przyjmuję do wiadomości, że z chwilą dostarczenia tracę ustawowe prawo odstąpienia od umowy w terminie 14 dni (art. 38 ust. 1 pkt 13 ustawy o prawach konsumenta). Niezależnie od tego przysługuje mi 14-dniowa gwarancja zwrotu {SITE_NAME} opisana w Regulaminie.
# Zostaw puste, żeby użyć domyślnej. {BASE_URL} i {SITE_NAME} zostaną podmienione; Stripe renderuje linki Markdown; limit 1200 znaków.
# CHECKOUT_TERMS_TEXT=
# Krótki tekst nad przyciskiem płatności (informacja o natychmiastowym dostarczeniu – art. 12 ust. 1 pkt 12 UPK).
# Domyślnie (src/config.js): „Dostęp wyślemy od razu na e-mail. 14 dni gwarancji zwrotu.” – zostaw puste, żeby użyć domyślnego.
# CHECKOUT_SUBMIT_TEXT=
# Wymuś tryb testowy mimo klucza (np. na staging): MOCK_MODE=1
# MOCK_MODE=0

# ---- E-mail z dostępem (Resend: https://resend.com -> API Keys) ----
# Brak klucza = e-maile są zapisywane do plików w data/outbox/ zamiast wysyłki.
RESEND_API_KEY=re_...
# Nadawca – domena musi być zweryfikowana w Resend
EMAIL_FROM=Nazwa Marki <kontakt@twojadomena.pl>
# Opcjonalnie adres na odpowiedzi klientów
EMAIL_REPLY_TO=kontakt@twojadomena.pl

# ---- Meta (Pixel + Conversions API) ----
# Events Manager -> Data sources -> Pixel ID. Brak = Pixel i CAPI wyłączone.
META_PIXEL_ID=
# Events Manager -> Settings -> Conversions API -> Generate access token
META_CAPI_TOKEN=
# Tylko na czas testów (Events Manager -> Test events); w produkcji zostaw puste
META_TEST_EVENT_CODE=

# ---- Panel admina https://twojadomena.pl/admin (wymagane w produkcji) ----
ADMIN_USER=admin
ADMIN_PASS=wpisz-dlugie-haslo-min-10-znakow

# ---- Zaawansowane (zwykle bez zmian) ----
# Sól do skracania adresów IP w statystykach – wpisz dowolny losowy ciąg
IP_HASH_SALT=losowy-ciag-znakow
# Katalog na bazę danych i outbox (w Dockerze: /app/data)
# DATA_DIR=./data
# Ile warstw proxy przed aplikacją (Caddy = 1)
# TRUST_PROXY=1
